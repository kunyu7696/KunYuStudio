// KunYuEcosystem AI Reference v3.2 | neoforge/1.21.11/block/loot_table.json | mapping: Mojang official | provenance: adapted from official loader MDK/docs
// ============================================================================
{
  // ================================================================
  // 方块掉落物 JSON（NeoForge 1.21.11）
  // ================================================================
  // 位置：src/main/resources/data/examplemod/loot_table/blocks/example_block.json
  // 注意：1.21 起目录名改为单数 loot_table（1.20.x 是 loot_tables）。
  // 结构：alternatives（时序选择）→ 有精准采集时掉自身，否则正常掉落。
  // ================================================================
  "type": "minecraft:block",
  "pools": [
    {
      "rolls": 1,
      "bonus_rolls": 0,
      "entries": [
        {
          // alternatives：取第一个满足条件的子项
          "type": "minecraft:alternatives",
          "children": [
            {
              "type": "minecraft:item",
              "name": "examplemod:example_block",
              // 精准采集时掉自身
              "conditions": [
                {
                  "condition": "minecraft:match_tool",
                  "predicate": {
                    "enchantments": [
                      { "enchantment": "minecraft:silk_touch", "levels": { "min": 1 } }
                    ]
                  }
                }
              ]
            },
            {
              // 无精准采集时也掉自身；想掉其它物品改 "name" 即可
              "type": "minecraft:item",
              "name": "examplemod:example_block"
            }
          ]
        }
      ],
      // 掉落数量函数；可改为 { "min": 1, "max": 3 }
      "functions": [
        { "function": "minecraft:set_count", "count": 1 }
      ]
    }
  ]
}
